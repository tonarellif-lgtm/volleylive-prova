# Copia questo file in ".env" (stessa cartella del docker-compose.yml) e scrivi un codice lungo e casuale.
# Lo stesso codice va nel campo «Codice di accesso» della pagina VolleyLive.
STREAM_TOKEN=scrivi-qui-un-codice-lungo-e-casuale

# Facoltativi
# ALLOWED_ORIGINS=https://tonarellif-lgtm.github.io
# ALLOWED_HOSTS=server-rtmp-extra.example.com
# MODE=auto
# MAX_SESSIONS=1

# Per collegarti direttamente a https/wss, per esempio con la VPN dall'indirizzo IP del NAS (crea i file con ./make-cert.sh, vedi README):
# TLS_CERT=/certs/server.crt
# TLS_KEY=/certs/server.key
